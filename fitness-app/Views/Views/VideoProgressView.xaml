<?xml version="1.0" encoding="utf-8"?>

<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="fitness_app.Views.Views.VideoProgressView"
             xmlns:pr="clr-namespace:MPowerKit.ProgressRing;assembly=MPowerKit.ProgressRing"
             x:Name="This">
    
    <Grid>
        <pr:ProgressRing x:Name="progressRing"
                         Progress="{Binding Progress, Source={x:Reference This}}"
                         Color="{Binding RingColor, Source={x:Reference This}}"
                         Thickness="{Binding RingThickness, Source={x:Reference This}}"
                         WidthRequest="{Binding RingWidth, Source={x:Reference This}}"
                         HeightRequest="{Binding RingHeight, Source={x:Reference This}}"/>
        <Label Text="{Binding CurrentVideoTime, Source={x:Reference This}}"
               HorizontalOptions="Center"
               VerticalOptions="Center"
               FontFamily="{Binding TimeFontFamily, Source={x:Reference This}}"
               FontSize="{Binding TimeFontSize, Source={x:Reference This}}"
               TextColor="{Binding TimeTextColor, Source={x:Reference This}}"/>
    </Grid>
</ContentView>